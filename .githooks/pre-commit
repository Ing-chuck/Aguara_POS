#!/bin/sh
# Stops a commit that changes the public headers without raising the API level.
# Turn it on once in each clone: git config core.hooksPath .githooks
if ! command -v python > /dev/null; then
    echo "python not found: API level not checked"
    exit 0
fi
exec python -B "$(git rev-parse --show-toplevel)/autoVersion.py" check
